# Copy this file to .env. Values here are examples, not secrets.
# Display-only classification banner. Same key as the GitLab CI/CD dropdown.
# Options: UNCLASSIFIED (default), CUI, CONFIDENTIAL, SECRET, TOP SECRET, ITAR, CUSTOM
# This is a label. It is not an ATO or a claim the demo can hold CUI or classified.
CLASSIFICATION=UNCLASSIFIED
CLASSIFICATION_CUSTOM_TEXT=
CLASSIFICATION_CUSTOM_COLOR=
CLASSIFICATION_TEXT=
# Hidden unless 1/true/yes. Demo email/password fields stay off otherwise.
DEMO_LOGIN=
# Required. Must not be empty, a banned stand-in, or contain example/default.
FLASK_SECRET=
FLASK_DEBUG=0
HOST=127.0.0.1
