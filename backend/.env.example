# Leave OKTA_ISSUER empty to use the built-in mock IdP.
# When set, the app expects a real OIDC issuer (not implemented in this demo).
OKTA_ISSUER=
OKTA_CLIENT_ID=mock-f18-client
OKTA_CLIENT_SECRET=mock-f18-secret
OKTA_REDIRECT_URI=http://localhost:5173/api/auth/callback
FLASK_SECRET=change-me-in-production
FLASK_DEBUG=1

# Who receives access-request emails. Default is a local demo address.
SIGNUP_NOTIFY_EMAIL=program.access@localhost
# Optional From: for notifications.
SIGNUP_FROM_EMAIL=f18-portal@localhost
# If SMTP_HOST is set, notifications are sent for real; otherwise a .eml
# is written to backend/mailbox/ only.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=1

# Doxygen HTML (auth-gated). If unset, backend/doxygen-mock/html is served.
# Prefer a public prefix URL so the server does not need AWS keys:
# S3_DOXYGEN_BASE_URL=https://your-bucket.s3.amazonaws.com/html
# Private bucket (boto3 uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY):
# S3_DOXYGEN_BUCKET=
# S3_DOXYGEN_PREFIX=html
# S3_DOXYGEN_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# User-facing copy: edit backend/copy.json, or overlay one key.
# Longest section prefix wins (COPY_SIGNUP_SENT_TITLE → signupSent.title).
# COPY_LOGIN_TITLE=Test
# COPY_SIGNUP_SENT_TITLE=Request received
# COPY_BRAND_PROGRAM_NAME=F/A-18 Super Hornet
# COPY_FILE=/absolute/or/backend-relative/copy.json
